    "typescript",
    "postcss",
    "parse5",
    "ast",
    "tailwind",
    "open-source"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@bramus/specificity": "^2.4.2",
